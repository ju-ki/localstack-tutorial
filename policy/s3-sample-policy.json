{
  "Version": "2012-10-17",
  "Statement": [
    {
          "Sid": "SampleS3ListRole",
          "Effect": "Allow",
          "Action": ["s3:ListBucket"],
          "Resource": "arn:aws:s3:::s3-demo-bucket"
    },
    {
          "Sid": "SampleS3DetailRole",
          "Effect": "Allow",
          "Action": ["s3:GetObject"],
          "Resource": "arn:aws:s3:::s3-demo-bucket/*"
    }
  ]
}
